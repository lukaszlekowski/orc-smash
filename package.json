{
  "name": "orc-smash",
  "version": "1.0.0",
  "description": "A thin TypeScript CLI harness that drives coding-agent CLIs through config-driven approval loops, tasks, and pipelines",
  "main": "dist/src/cli.js",
  "type": "module",
  "bin": {
    "orc": "./bin/orc.js"
  },
  "license": "MIT",
  "author": "Lukasz Lekowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukaszlekowski/orc-smash.git"
  },
  "homepage": "https://github.com/lukaszlekowski/orc-smash#readme",
  "bugs": {
    "url": "https://github.com/lukaszlekowski/orc-smash/issues"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "harness",
    "pipeline",
    "opencode",
    "codex",
    "claude",
    "approval-loop",
    "artifact-validation"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "bin/",
    "config/",
    "roles/",
    "skills/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/src/adapters && cp -R config roles skills package.json dist/ && cp src/adapters/process-group-bootstrap.mjs dist/src/adapters/process-group-bootstrap.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
